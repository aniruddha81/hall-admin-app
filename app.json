{
  "expo": {
    "name": "RUET Hall Admin",
    "slug": "hall-admin-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "halladminapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "edu.ruet.hall.admin"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "edu.ruet.hall.admin",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "auto",
          "hidden": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "auto",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RUET Hall Admin to access photos for your profile and receipt uploads.",
          "cameraPermission": "Allow RUET Hall Admin to take a photo for your profile picture."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
